#!/usr/bin/env sh
set -eu

# Keep the repository's existing Git LFS safeguard before running the Unity gate.
if command -v git-lfs >/dev/null 2>&1; then
    git lfs pre-push "$@"
else
    echo >&2 "\nThis repository is configured for Git LFS but 'git-lfs' was not found on your path. If you no longer wish to use Git LFS, remove this hook by deleting .githooks/pre-push.\n"
    exit 2
fi

repo_root="$(git rev-parse --show-toplevel)"

if command -v pwsh >/dev/null 2>&1; then
    powershell_command=pwsh
elif command -v powershell.exe >/dev/null 2>&1; then
    powershell_command=powershell.exe
else
    echo >&2 'PowerShell was not found. Install PowerShell before pushing so the TAD Game Basics test gate can run.'
    exit 1
fi

exec "$powershell_command" -NoProfile -ExecutionPolicy Bypass -File "$repo_root/Tools/RunGameBasicsTests.ps1"
